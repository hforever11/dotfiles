# https://github.com/catppuccin/delta (syntax-theme は bat テーマ非依存の none に変更。
# 文字色 file-style と赤 (minus 系)・緑 (plus 系)・map-styles の色は home/theme.nix の
# text / red / green / mauve / blue / sky / yellow に合わせて変更。
# 混色の比率と相手の base #eff1f5 は upstream のまま)
[delta "catppuccin-latte"]
	blame-palette = "#eff1f5 #e6e9ef #dce0e8 #ccd0da #bcc0cc"
	commit-decoration-style = "#9ca0b0" bold box ul
	light = true
	file-decoration-style = "#9ca0b0"
	file-style = "#44455d"
	hunk-header-decoration-style = "#9ca0b0" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#6c6f85"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#9ca0b0"
	line-numbers-minus-style = bold "#a03e43"
	line-numbers-plus-style = bold "#47894f"
	line-numbers-right-style = "#9ca0b0"
	line-numbers-zero-style = "#9ca0b0"
	# 35% red 65% base
	minus-emph-style = bold syntax "#d3b2b7"
	# 20% red 80% base
	minus-style = syntax "#dfcdd1"
	# 35% green 65% base
	plus-emph-style = bold syntax "#b4cdbb"
	# 20% green 80% base
	plus-style = syntax "#cddcd4"
	# 35% mauve / blue / sky / yellow 65% base
	map-styles = \
		bold purple => syntax "#c0b6d6", \
		bold blue => syntax "#b2c2dd", \
		bold cyan => syntax "#b5d0e1", \
		bold yellow => syntax "#decdb6"
	syntax-theme = none
